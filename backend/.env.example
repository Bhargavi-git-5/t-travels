# Copy this file to .env and fill in real values before running the server

# MongoDB connection string.
# Local example:      mongodb://127.0.0.1:27017/ttravels
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ttravels
MONGO_URI=mongodb://127.0.0.1:27017/ttravels

# Any long random string. Used to sign JWT tokens.
JWT_SECRET=change_this_to_a_long_random_string

# Port the API server runs on
PORT=5000

# The frontend URL, used for CORS
CLIENT_URL=http://localhost:3000
